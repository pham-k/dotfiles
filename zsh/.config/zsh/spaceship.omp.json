{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "foreground": "blue",
          "style": "plain",
          "template": "{{ .UserName }} ",
          "type": "session"
        },
        {
          "foreground": "green",
          "options": {
            "style": "folder"
          },
          "style": "plain",
          "template": "<default>in</> {{ .Path }} ",
          "type": "path"
        },
        {
          "foreground": "red",
          "options": {
            "branch_icon": "<red><b>\ue0a0 </b></>"
          },
          "style": "plain",
          "template": "<default>on</> {{ .HEAD }}",
          "type": "git"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "green",
          "style": "plain",
          "template": "\u276f",
          "type": "text"
        }
      ],
      "type": "prompt"
    }
  ],
  "final_space": true,
  "version": 3
}
